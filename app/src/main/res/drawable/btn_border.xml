<!-- res/drawable/btn_border.xml -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Fond transparent -->
    <solid android:color="@android:color/transparent" />

    <!-- Bordure blanche de 2dp -->
    <stroke
        android:width="2dp"
        android:color="#FFFFFF" />  <!-- Couleur de la bordure (blanc ici) -->

    <!-- Coins arrondis (optionnel) -->
    <corners android:radius="8dp" />  <!-- Ajustez le rayon selon vos besoins -->
</shape>