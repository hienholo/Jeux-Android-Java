<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#FF000000"
    android:padding="32dp">

    <!-- Titre -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Menu Principal"
        android:textColor="#FFFF4444"
        android:textSize="36sp"
        android:textStyle="bold"
        android:layout_marginBottom="40dp"/>

    <!-- Boutons de jeu -->
    <Button
        android:id="@+id/btn_jouer"
        android:layout_width="240dp"
        android:layout_height="60dp"
        android:text="Jouer"
        android:textColor="#FFFFFFFF"
        android:textSize="24sp"
        android:backgroundTint="#FFFF4444"
        android:textAllCaps="false"
        android:elevation="8dp"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btn_jouer_ami"
        android:layout_width="240dp"
        android:layout_height="60dp"
        android:text="Jouer avec un Ami"
        android:textColor="#FFFFFFFF"
        android:textSize="24sp"
        android:backgroundTint="#FFFF4444"
        android:textAllCaps="false"
        android:elevation="8dp"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btn_entrainement"
        android:layout_width="240dp"
        android:layout_height="60dp"
        android:text="Entraînement"
        android:textColor="#FFFFFFFF"
        android:textSize="24sp"
        android:backgroundTint="#FFFF4444"
        android:textAllCaps="false"
        android:elevation="8dp"
        android:layout_marginBottom="24dp"/>

    <!-- Séparateur -->
    <View
        android:layout_width="160dp"
        android:layout_height="2dp"
        android:background="#FFFF4444"
        android:layout_marginVertical="16dp"/>

    <!-- Options supplémentaires -->
    <Button
        android:id="@+id/btn_scores"
        android:layout_width="240dp"
        android:layout_height="60dp"
        android:text="Mes Scores"
        android:textColor="#FFFFFFFF"
        android:textSize="24sp"
        android:backgroundTint="#FF444444"
        android:textAllCaps="false"
        android:elevation="8dp"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btn_quitter"
        android:layout_width="240dp"
        android:layout_height="60dp"
        android:text="Quitter"
        android:textColor="#FFFFFFFF"
        android:textSize="24sp"
        android:backgroundTint="#FF222222"
        android:textAllCaps="false"
        android:elevation="8dp"/>

</LinearLayout>