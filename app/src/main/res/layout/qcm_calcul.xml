<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#000000"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center">

    <TextView
        android:id="@+id/txtNiveau"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="NIVEAU : DÉBUTANT"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textAllCaps="true"
        android:gravity="center"
        android:layout_marginBottom="2dp"
        android:textColor="#4CAF50"
        android:paddingBottom="20dp"
        />

    <!-- Score et compteur -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="0dp">


        <TextView
            android:id="@+id/txtScore"
            android:text="✔ 0   ❌ 0"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>

        <TextView
            android:id="@+id/txtCompteur"
            android:text="1/10"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:gravity="end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- Question -->
    <TextView
        android:id="@+id/txtQuestion"
        android:text="Quel est le résultat de 7 × 8 ?"
        android:textSize="26sp"
        android:textColor="#00FFFF"
        android:gravity="center"
        android:layout_marginTop="32dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- Réponses -->
    <Button
        android:id="@+id/btn1"
        android:text="Réponse 1"
        android:textSize="20sp"
        android:layout_marginTop="24dp"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:backgroundTint="#3333FF"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="12dp"
        android:background="@drawable/btn_rounded" />

    <Button
        android:id="@+id/btn2"
        android:text="Réponse 2"
        android:textSize="20sp"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:backgroundTint="#3333FF"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="12dp"
        android:background="@drawable/btn_rounded" />

    <Button
        android:id="@+id/btn3"
        android:text="Réponse 3"
        android:textSize="20sp"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:backgroundTint="#3333FF"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="12dp"
        android:background="@drawable/btn_rounded" />

    <Button
        android:id="@+id/btn4"
        android:text="Réponse 4"
        android:textSize="20sp"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:backgroundTint="#3333FF"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="12dp"
        android:background="@drawable/btn_rounded" />

</LinearLayout>
