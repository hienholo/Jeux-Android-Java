<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Arrière-plan avec superposition semi-transparente -->
    <ImageView
        android:id="@+id/backgroundGif"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:background="@drawable/catgif"
        android:contentDescription="GIF background" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000" />

    <!-- Contenu principal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <!-- Titre -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choisissez un Mode"
            android:textColor="#FFFF4444"
            android:textSize="32sp"
            android:textStyle="bold"
            android:layout_marginBottom="40dp"
            android:fontFamily="sans-serif-condensed"/>

        <!-- Conteneur des boutons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#000000"
            android:padding="24dp"
            android:elevation="16dp">

            <!-- Bouton Culture Générale -->
            <Button
                android:id="@+id/btnLabyrinthe"
                android:layout_width="280dp"
                android:layout_height="80dp"
                android:text="Labyrinthe"
                android:textAllCaps="false"
                android:textSize="22sp"
                android:textColor="#FFFFFFFF"
                android:backgroundTint="#D0FF4444"
                android:fontFamily="sans-serif-medium"
                android:drawableTint="#FFFFFFFF"
                android:elevation="8dp"
                android:letterSpacing="0.02"
                android:layout_marginBottom="24dp"/>

            <!-- Séparateur -->
            <View
                android:layout_width="200dp"
                android:layout_height="2dp"
                android:background="#60FFFFFF"
                android:layout_marginVertical="16dp"/>

            <!-- Bouton Calcul Mental -->
            <Button
                android:id="@+id/btnIntruit"
                android:layout_width="280dp"
                android:layout_height="80dp"
                android:text="Pods Game"
                android:textAllCaps="false"
                android:textSize="22sp"
                android:textColor="#FFFFFFFF"
                android:backgroundTint="#D0FF4444"
                android:fontFamily="sans-serif-medium"
                android:drawableTint="#FFFFFFFF"
                android:elevation="8dp"
                android:letterSpacing="0.02"/>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>